# ============================================================================
# esg_s11_scorer 本机配置模板
#   用法：python -m esg_s11_scorer --init-env      ← 复制成 .env（已存在则不覆盖）
#   优先级：命令行参数 > 进程环境变量 > 本文件 > 代码里的默认值
#   相对路径一律相对「项目根」（ESG_PROJECT_ROOT，默认 = 本包上两级目录）
#   正斜杠或反斜杠都行；.env 不进版本库，密钥只写 .env，不要写进本模板
# ============================================================================

# ---- 项目根（一般不用改；换了机器/移动了目录时才有用）----
# ESG_PROJECT_ROOT=.

# ---- 报告年度（决定默认的 FY 子目录与报告标题）----
# ESG_YEAR=2025
#
# ★ 路径里可以写 {year} / {year-1}，会被换成 ESG_YEAR 的值：
#     ESG_PDF_DIR=.../ESG报告/FY{year}        →  .../ESG报告/FY2025
#     ESG_OVERRIDE_CSV=.../overrides_FY{year}.csv
#   换年度只改 ESG_YEAR 一行，其余自动跟随。把 FY2025 写死的后果是静默串档
#   （今年批次套用去年的人工值），--show-config 会对「年度 vs 目录名」不一致给出警告。

# ---- 输入 ----
# 1) 报告根目录：其下有 FY2025/ FY2024/ 这样的年份子目录
# ESG_REPORT_ROOT=50-应用/good_sample/分析指标/ESG报告
# 2) 直接给输入：某个年份目录，或单份 PDF 的完整路径
#    留空 = ${ESG_REPORT_ROOT}/FY${ESG_YEAR}
# ESG_PDF_DIR=50-应用/good_sample/分析指标/ESG报告/FY{year}
# 上一年报告目录（用于取「上期流失率/上期薪酬差距」）；留空 = 自动取 PDF 同级的 FY{year-1}
# ESG_PRIOR_DIR=50-应用/good_sample/分析指标/ESG报告/FY{year-1}

# ---- 输出（给人看的交付物）----
# 其下自动分 FY{year}/ 放每家报告，批次汇总/图册落在本层
# ESG_OUT_DIR=50-应用/good_sample/分析指标/打分结果
# 中间态（阶段产物 JSON + gold 表）：可随时删掉重算，不在版本库里
# ESG_BUILD_DIR=50-应用/esg_s11_scorer/build

# ---- 只读依赖：指标标准原文与要素词表仓库 ----
# ESG_INSIGHT_APP=50-应用/ESG_insight/app
# ESG_STANDARD_DOC=50-应用/sample/02-指标标准/S1.1_指标与判断标准.md

# ---- 定性召回词表（四列 CSV，Excel 可直接编辑；留空 = 包内 keywords.csv）----
# 换一个项目/一套口径时指到自己的词表；改完重启进程才生效（进程启动时读一次）
# ESG_S11_KEYWORDS=50-应用/esg_s11_scorer/keywords.csv

# ---- 对标与人工兜底 ----
# A/B 是相对分位：auto=本批互为对标，csv=读外部对标表，none=不评
# ESG_BENCH=auto
# ESG_BENCH_CSV=50-应用/good_sample/分析指标/对标库/行业流失率.csv
# 抽不到数值时人工补（code,field,year,value,reason）；留空 = 不读；今年没有该文件不算错
# ESG_OVERRIDE_CSV=50-应用/good_sample/分析指标/打分结果/overrides_FY{year}.csv
# 盲评脱敏别名表（code,alias）：文件名/股票代码看不出来的中文名、品牌、子公司旧名
# ESG_ALIAS_CSV=50-应用/good_sample/分析指标/打分结果/aliases_FY{year}.csv

# ---- 定性判档 LLM（OpenAI 兼容端点；不填则只用关键词兜底）----
# 阿里百炼：base=https://dashscope.aliyuncs.com/compatible-mode/v1  模型如 qwen-plus / qwen-max
# API key 属于密钥，只写进 .env（已在 .gitignore），**不要**写进本模板、README 或代码
# ESG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ESG_LLM_MODEL=qwen-plus
# 思维链开关（默认关）。deepseek-v4.1-flash 这类模型默认先刷推理，会把 token 预算吃光、
# 让 JSON 输出被截断，所以判档场景默认关闭。
# ESG_LLM_THINKING=0
# ESG_LLM_API_KEY=

# ---- 三路独立判档（ensemble.py：只采集、不出分，量「判档稳定性」）----
# 投票人逗号分隔，形如 模型名@温度；沿用上面同一个 base_url / API key。
# 留空 = 主模型跑三个温度（0.0 / 0.7 / 0.9），不需要额外配置。
# 想跨模型比较：ESG_ENSEMBLE_VOTERS=qwen-plus@0.7,qwen-max@0.7,qwen-turbo@0.7
# 用法：python -m esg_s11_scorer.ensemble --limit 2   （先试跑，再跑全量）
# ESG_ENSEMBLE_VOTERS=

# ---- 外部资源（备用：打分链路不读库、不登服务器；给后续入库/取数阶段用）----
# 只在本模板留占位符；真实值写进 .env。四项齐备才算可用，缺一项 db_params() 会抛错。
# ESG_DB_HOST=your-mysql-host
# ESG_DB_PORT=3306
# ESG_DB_USER=your-mysql-user
# ESG_DB_PASSWORD=your-mysql-password
# ESG_DB_NAME=esg
# ESG_DB_CHARSET=utf8mb4
#
# GPU 服务器：管理地址 + 每个账号的 用户名/密码/工作目录。
# ESG_GPU_DEFAULT 选一个默认账号（kyrie / zixin），gpu_account() 不传参时用它。
# 目录是服务器上的路径，不参与本机的「路径是否存在」检查。
# ESG_GPU_HOST=your-gpu-host
# ESG_GPU_PORT=22
# ESG_GPU_DEFAULT=zixin
# ESG_GPU_ZIXIN_USER=
# ESG_GPU_ZIXIN_PASSWORD=
# ESG_GPU_ZIXIN_DIR=/public/home/<user>/<dir>
# ESG_GPU_KYRIE_USER=
# ESG_GPU_KYRIE_PASSWORD=
# ESG_GPU_KYRIE_DIR=/public/home/<user>/<dir>

# ---- 校准集（calibrate.py 用，平时不用管）----
# ESG_SAMPLE_PDF_DIR=50-应用/sample/01-源PDF
# ESG_VERDICTS=50-应用/sample/04-脚本与索引/verdicts.py

# ---- 想用另一个配置文件（不是本文件名）时 ----
# ESG_ENV_FILE=.env.2026